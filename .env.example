# ---------------------------------------------------------------------------
# Copy to .env and fill in. Never commit the filled-in file — .gitignore
# covers .env* and allows only this template through.
#
# Prisma reads ONLY .env (not .env.local). Next.js reads both.
# On Vercel, ALL FOUR of these must be set in the project's Environment
# Variables — .env.local is a local-development file and Vercel never reads it.
# ---------------------------------------------------------------------------

# POOLED connection — hostname CONTAINS "-pooler".
# Used by the app at runtime. Serverless functions open many short-lived
# connections; the pooler is what stops them exhausting Postgres.
#
# connection_limit=1 is not optional on serverless: Prisma's default pool is
# (cpus * 2 + 1) PER INSTANCE, so thirty concurrent instances open 150+
# backends. pgbouncer=true stops Prisma using named prepared statements,
# which is the usual cause of intermittent
# `prepared statement "s0" already exists` under load.
DATABASE_URL="postgresql://USER:PASSWORD@HOST-pooler.REGION.aws.neon.tech/neondb?sslmode=require&pgbouncer=true&connection_limit=1"

# DIRECT connection — same hostname WITHOUT "-pooler", port 5432.
# Used only by `prisma migrate`. Migrations need a real session and break
# through the pooler.
DIRECT_URL="postgresql://USER:PASSWORD@HOST.REGION.aws.neon.tech/neondb?sslmode=require"

# Auth.js session signing key. Generate a fresh one per environment:
#   openssl rand -base64 32
AUTH_SECRET=""

# Base URL for Auth.js callbacks. Auth.js v5 prefers AUTH_URL; NEXTAUTH_URL is
# still read for compatibility. In production set this to the real origin.
AUTH_URL="http://localhost:3000"

# Checklist before running anything:
#   1. Both URLs point at the SAME Neon branch — use a dev branch while building.
#   2. Only DATABASE_URL contains "-pooler".
#   3. AUTH_SECRET differs between local and production.
