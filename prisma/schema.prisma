// ============================================================================
// Spring Citadel International School — portal schema
//
// Conventions used throughout:
//   * Soft delete is expressed as `status = INACTIVE`, never a deletedAt
//     column. Historical grades must survive a student or teacher leaving.
//   * Money-like integers (scores) are plain Int with bounds enforced in
//     lib/grading.ts and re-validated server-side on every write.
//   * Multi-tenancy is deliberately NOT implemented. Adding a School model and
//     a schoolId column later is a single additive migration; carrying it now
//     would put an unused foreign key on every query for the whole build.
// ============================================================================

generator client {
  // Classic generator: outputs to node_modules/@prisma/client so you import
  // from "@prisma/client". Prisma 6's init scaffolds the newer "prisma-client"
  // provider with a custom output dir, which triggers the Turbopack module
  // resolution bug on Next 16.
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  // Pooled connection — used by the app at runtime.
  url       = env("DATABASE_URL")
  // Direct connection — used by `prisma migrate`. Migrations need a real
  // session and break through the pooler.
  directUrl = env("DIRECT_URL")
}

// ─── Enums ──────────────────────────────────────────────────────────────────

enum Role {
  ADMIN
  TEACHER
  STUDENT
}

enum Level {
  EARLY_YEARS
  PRIMARY
  JSS
  SS
}

// SS field of study. Senior Secondary students take the five compulsory core
// subjects plus electives drawn from one field (at least 2 from the field +
// 1 other). JSS has no field structure, so JSS-only subjects carry an empty
// `streams` array rather than a placeholder value.
enum SubjectStream {
  CORE
  SCIENCE
  ARTS
  COMMERCIAL
}

enum Gender {
  MALE
  FEMALE
}

enum StudentStatus {
  ACTIVE
  AT_RISK
  INACTIVE
}

enum TeacherStatus {
  ACTIVE
  ON_LEAVE
  INACTIVE
}

enum Term {
  TERM_1
  TERM_2
  TERM_3
}

enum LetterGrade {
  A
  B
  C
  D
  F
}

enum GradeStatus {
  DRAFT
  SUBMITTED
}

// Phase 4. LATE and EXCUSED both count differently from a plain ABSENT when
// compileClassResults() rolls a term's Attendance rows into
// TermResult.attendancePresent/attendanceTotal — see that function's
// comment for exactly how each status is treated.
enum AttendanceStatus {
  PRESENT
  ABSENT
  LATE
  EXCUSED
}

enum NotificationType {
  STUDENT_ENROLLED
  GRADES_SUBMITTED
  STUDENT_AT_RISK
  GRADES_PUBLISHED
  // Raised when an administrator removes someone's profile photo. The person
  // whose photo it was is told, always. Silent removal would be the wrong
  // behaviour on a portal used by children: they would keep seeing their
  // initial, assume the upload had failed, and try again — and nobody would
  // ever learn that a member of staff had made a decision about it.
  PROFILE_PHOTO_REMOVED

  // FR-style: a student's termly result was published — the one
  // notification event Phase 2 raises, replacing the per-input noise
  // (subject submitted, psychomotor submitted) that already exists on
  // GRADES_SUBMITTED with a single "your result is ready" once everything
  // feeding it has been compiled and an admin has published it.
  RESULT_PUBLISHED
}

// ─── Identity ───────────────────────────────────────────────────────────────

model User {
  id       String @id @default(uuid())
  name     String
  email    String @unique
  password String // bcrypt hash, cost >= 10

  role Role

  // Set true whenever an admin issues a temporary password. Middleware forces
  // a change before any other route is reachable. This is what makes dropping
  // the self-serve reset flow safe: credentials can be handed over on paper
  // without leaving a permanent shared secret.
  mustChangePassword Boolean @default(true)

  // Session revocation. Sessions are JWTs with no server-side store, so a
  // cookie stayed valid for its full 30-day life no matter what happened to
  // the account: a password reset did not invalidate a stolen session, and
  // an expelled student or dismissed teacher kept full access until the
  // token expired (the status gate only runs at login). Every password
  // change and every deactivation increments this; auth.config.ts compares
  // the token's copy against the row on each request.
  tokenVersion Int @default(0)

  // ─── Profile picture ──────────────────────────────────────────────────
  // Stored IN POSTGRES rather than in object storage, deliberately.
  //
  // The images are downscaled to a 256px square JPEG in the browser before
  // they are ever sent (see app/portal/(app)/profile/avatar-uploader.tsx),
  // which puts each one at roughly 30-60KB. A thousand accounts is therefore
  // tens of megabytes — a rounding error against the grade tables, and no
  // new service, credential, CSP origin or failure mode to operate. Object
  // storage is the right answer at a scale this school does not have; the
  // migration to it is a background copy plus a URL column, and nothing
  // outside lib/avatar.ts and the /avatar route would need to change.
  //
  // The bytes are @db.ByteA and are NEVER selected by the ordinary user
  // queries — only app/portal/(app)/avatar/[userId]/route.ts reads this
  // column. Selecting it accidentally on a list page would drag every
  // student's photo through a query that wanted their name.
  avatar     Bytes?
  // The MIME type the bytes were saved as, so the serving route never has to
  // sniff them and never has to guess. Always "image/jpeg" today; stored
  // rather than assumed so a future format does not need a data migration.
  avatarType String?
  // Cache-busting key for the serving route. Without it, a browser that has
  // cached /avatar/<id> keeps showing the OLD photo after a change — the
  // single most common bug in avatar features — and the only fix available
  // to the user is a hard refresh they will never think to do.
  avatarUpdatedAt DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  student       Student?
  teacher       Teacher?
  notifications Notification[]

  @@index([role])
}

// ─── School structure ───────────────────────────────────────────────────────

model Class {
  id    String @id @default(uuid())
  name  String // "JSS 3A"
  code  String @unique // "JSS3A" — used in admission numbers
  level Level

  // Grade entry is enabled for JSS and SS only in v1. Early Years and Primary
  // are enrolled and profiled but not scored, because the 20/30/50 assessment
  // split does not apply to them. Flipping this boolean is the whole change if
  // the school confirms Primary uses the same scheme.
  gradingEnabled Boolean @default(false)

  // The class's ONE form/class teacher — distinct from TeacherAssignment,
  // which is per (teacher, class, SUBJECT) and can hold several teachers per
  // class with no single owner. This is who owns psychomotor ratings,
  // attendance and remarks for the class (see PsychomotorRating.ratedById
  // and requireFormTeacher() in lib/teacher.ts). @unique on the FK, not just
  // the relation, because a teacher is form teacher of at most one class —
  // this is what makes that a database constraint, not just a UI rule an
  // admin could bypass by hitting the action twice from two tabs.
  // Nullable: a newly-seeded class has no form teacher until an admin
  // assigns one, and grade entry / enrolment must keep working regardless.
  formTeacherId String?  @unique
  formTeacher   Teacher? @relation("ClassFormTeacher", fields: [formTeacherId], references: [id], onDelete: SetNull)

  createdAt DateTime @default(now())

  students    Student[]
  assignments TeacherAssignment[]
  grades      Grade[]
  psychomotorRatings PsychomotorRating[]
  termResults TermResult[]
  attendances Attendance[]

  @@index([level])
}

model Subject {
  id   String @id @default(uuid())
  name String
  code String @unique

  // A subject may be taught at more than one level (Mathematics runs across
  // JSS and SS), so this is an array rather than a single enum.
  levels Level[]

  // SS field grouping, confirmed by the school 14 Aug 2026. An array for the
  // same reason `levels` is: a subject can sit in more than one field —
  // Geography is listed under both Science and Arts, and the Nigerian
  // languages are a compulsory core pick that also counts as an Arts
  // elective. Empty for JSS-only subjects, which have no field structure.
  streams SubjectStream[]

  // True only for the SS subjects every student must take. The three Nigerian
  // languages are marked compulsory as a *group* — a student takes one of
  // Hausa / Igbo / Yoruba, not all three. Enforcing "exactly one of" is a
  // subject-selection rule, not a column, so it is not modelled here.
  compulsory Boolean @default(false)

  createdAt DateTime @default(now())

  assignments      TeacherAssignment[]
  grades           Grade[]
  primaryTeachers  Teacher[]           @relation("TeacherPrimarySubject")
}

// ─── People ─────────────────────────────────────────────────────────────────

model Student {
  id          String @id @default(uuid())
  admissionNo String @unique // SCIS/2026/JSS3/001 — see lib/ids.ts

  userId String @unique
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  classId String
  class   Class  @relation(fields: [classId], references: [id], onDelete: Restrict)

  dob           DateTime
  gender        Gender
  guardianName  String
  guardianPhone String
  address       String

  // ─── Admission-form fields ──────────────────────────────────────────────
  // Captured on the paper "Application for Admission" form alongside the
  // fields above but not previously stored anywhere. All optional: every
  // student enrolled before this was added has none of it, and the office
  // may not always have every field in hand at enrolment time either.
  nationality    String?
  motherTongue   String?
  placeOfBirth   String?
  previousSchool String?

  // Up to three siblings currently studying at the school, as free-text
  // name + class — matches the three fixed rows on the paper form exactly.
  // A relation table would be the "correct" shape for an unbounded list, but
  // the form only ever asks for three, and free-text class avoids a second
  // foreign key to a Class row a sibling's class name might not still match.
  sibling1Name  String?
  sibling1Class String?
  sibling2Name  String?
  sibling2Class String?
  sibling3Name  String?
  sibling3Class String?

  // Father's and mother's details, as the admission form's two matching
  // columns. Distinct from guardianName/guardianPhone above, which is the
  // one contact the rest of the app (notifications, the office's "who do we
  // call") reads — the office picks which parent that field points to.
  fatherName         String?
  fatherNationality  String?
  fatherState        String?
  fatherProfession   String?
  fatherEmployer     String?
  fatherPoBox        String?
  fatherAddress      String?
  fatherPhone        String?
  fatherEmail        String?
  motherName         String?
  motherNationality  String?
  motherState        String?
  motherProfession   String?
  motherEmployer     String?
  motherPoBox        String?
  motherAddress      String?
  motherPhone        String?
  motherEmail        String?

  // The ONE field on this row a student may write themselves — a number the
  // school can reach THEM on, distinct from guardianPhone.
  //
  // Everything else here is a record of record: admissionNo, class, dob,
  // gender and the guardian's details are set by the office and corrected by
  // the office. That is a deliberate policy, not an oversight — see the note
  // at the top of app/portal/(app)/profile/page.tsx. Nullable because every
  // student who already exists has never been asked for one, and because a
  // student is never required to supply a personal number.
  contactPhone String?

  // AT_RISK is derived, never hand-set: recomputed from submitted grades on
  // every grade write. INACTIVE is the soft delete.
  status StudentStatus @default(ACTIVE)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  grades Grade[]
  psychomotorRatings PsychomotorRating[]
  termResults TermResult[]
  attendances Attendance[]

  // [classId] alone was a strict leftmost prefix of [classId, status] and
  // bought nothing.
  @@index([status])
  @@index([classId, status])
}

model Teacher {
  id      String @id @default(uuid())
  staffId String @unique // SCIS/TCH/2026/001

  userId String @unique
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  phone  String
  gender Gender

  // The teacher's headline subject, shown on their profile and used to filter
  // the teachers list. What they may actually grade is governed by
  // TeacherAssignment, not by this field.
  primarySubjectId String?
  primarySubject   Subject? @relation("TeacherPrimarySubject", fields: [primarySubjectId], references: [id], onDelete: SetNull)

  // ON_LEAVE keeps the account but blocks login. INACTIVE is the soft delete.
  status TeacherStatus @default(ACTIVE)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  assignments TeacherAssignment[]
  grades      Grade[]
  psychomotorRatings PsychomotorRating[]
  attendancesMarked  Attendance[]

  // The one class this teacher is form/class teacher of, if any — the other
  // side of Class.formTeacherId. Named to match that field's relation name;
  // a plain "class" name here would collide with nothing today but reads
  // ambiguously next to TeacherAssignment.class, which is a totally
  // different relationship (subject coverage, not ownership).
  formClass Class? @relation("ClassFormTeacher")

  @@index([status])
  @@index([primarySubjectId])
}

// FR-30: admins add and remove a teacher's class assignments. That is a
// many-to-many with a payload (which subject, in which class), so it needs its
// own table rather than an array column on Teacher.
//
// This table is also the authorisation source: a teacher may only write grades
// for a (class, subject) pair they hold a row for. That check runs server-side
// inside the action, never in the UI.
model TeacherAssignment {
  id String @id @default(uuid())

  teacherId String
  teacher   Teacher @relation(fields: [teacherId], references: [id], onDelete: Cascade)

  classId String
  class   Class  @relation(fields: [classId], references: [id], onDelete: Cascade)

  subjectId String
  subject   Subject @relation(fields: [subjectId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())

  @@unique([teacherId, classId, subjectId])
  @@index([classId, subjectId])
  // [teacherId] alone was a strict leftmost prefix of the unique above.
}

// ─── Grades ─────────────────────────────────────────────────────────────────

model Grade {
  id String @id @default(uuid())

  studentId String
  // Restrict, NOT Cascade. The schema header states "historical grades must
  // survive a student or teacher leaving" — the teacher relation below
  // honoured that and this one did the opposite, so a single DELETE on User
  // cascaded User -> Student -> Grade and erased a child's entire academic
  // history silently. Removal is a soft delete (status = INACTIVE); this
  // makes the database agree with that.
  student   Student @relation(fields: [studentId], references: [id], onDelete: Restrict)

  // Restrict, not Cascade: removing a teacher must never delete a child's
  // results. Teachers are soft-deleted, so this should never fire — it is here
  // so that a hard delete fails loudly instead of destroying records.
  teacherId String
  teacher   Teacher @relation(fields: [teacherId], references: [id], onDelete: Restrict)

  subjectId String
  subject   Subject @relation(fields: [subjectId], references: [id], onDelete: Restrict)

  // Denormalised from Student so the admin grades table can filter by class
  // without a join, and so a student changing class does not silently rewrite
  // last term's results.
  classId String
  class   Class  @relation(fields: [classId], references: [id], onDelete: Restrict)

  term    Term
  session String // "2026/2027"

  assignment Int // 0–20
  midterm    Int // 0–30
  exam       Int // 0–50

  // Both computed server-side from the three components on every write, never
  // accepted from the client. Stored rather than derived so the grades table
  // sorts and filters in SQL.
  total Int
  grade LetterGrade

  status      GradeStatus @default(DRAFT)
  submittedAt DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // The single most important constraint in the schema: one result row per
  // student, per subject, per term, per session. Without it, a double-submit
  // or a retried request silently duplicates a child's result and every
  // average computed afterwards is wrong.
  @@unique([studentId, subjectId, term, session])
  // [studentId] alone was a strict leftmost prefix of the unique above.
  // [status] alone was a two-value column the planner would never choose
  // over a sequential scan. Both dropped.
  @@index([classId, term, session])
  @@index([teacherId, status])

  // The admin dashboard groups by (session, term, status); nothing led with
  // session, so it scanned the whole table on every dashboard load.
  @@index([session, term, status])
  // "Submitted today" filtered on submittedAt with no index on it — at 100k
  // grades, where most are submitted, that read ~90k index entries per load.
  @@index([status, submittedAt])
  // The teacher profile counts submissions per (class, subject) for one
  // teacher, once per assignment.
  @@index([classId, subjectId, teacherId, status])
}

// One row per student per term: the affective/psychomotor domain, separate
// from academic subject grades in Grade above. Owned by the class's form
// teacher (Class.formTeacherId), not by whichever subject teacher happens to
// be looking — see requireFormTeacher() in lib/teacher.ts. Reuses
// GradeStatus (DRAFT/SUBMITTED) rather than inventing a parallel enum: the
// draft/submit/visibility lifecycle is identical to Grade's, including "a
// student never sees a DRAFT row."
model PsychomotorRating {
  id String @id @default(uuid())

  studentId String
  // Restrict, not Cascade — same reasoning as Grade.student: a student's
  // psychomotor history is part of their permanent record and must survive
  // whatever happens to the User row upstream of it.
  student   Student @relation(fields: [studentId], references: [id], onDelete: Restrict)

  // Denormalised from Student, same reason Grade.classId is: filters the
  // admin override list without a join, and a mid-term class change doesn't
  // silently rewrite which class a rating "belongs" to.
  classId String
  class   Class  @relation(fields: [classId], references: [id], onDelete: Restrict)

  term    Term
  session String // "2026/2027"

  // Standard Nigerian affective/psychomotor set, 1-5. A generic
  // trait+rating child table would let the list vary without a migration —
  // not worth it unless the rubric turns out to differ by level; start with
  // fixed columns, matching how Grade's three score components are modelled.
  punctuality Int
  neatness    Int
  honesty     Int
  leadership  Int
  cooperation Int
  handwriting Int
  sports      Int

  remark String? // the form teacher's free-text comment

  // Restrict, not Cascade, same reasoning as Grade.teacher: removing a
  // teacher must never delete a child's records. Named ratedBy rather than
  // teacher for readability at call sites once a report card is pulling
  // together Grade.teacher, PsychomotorRating.ratedBy and
  // TermResult.compiledBy in the same query.
  ratedById String
  ratedBy   Teacher @relation(fields: [ratedById], references: [id], onDelete: Restrict)

  status      GradeStatus @default(DRAFT)
  submittedAt DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // One rating per student per term per session — the same shape as Grade's
  // unique constraint, one level up (whole term, not per-subject).
  @@unique([studentId, term, session])
  @@index([classId, term, session])
}

enum ResultStatus {
  DRAFT
  COMPILED
  PUBLISHED
}

// One row per student per term: the compiled result — everything Grade and
// PsychomotorRating fed in, brought together, ranked, and (eventually)
// published. This is what "the admin generates the result" means in
// practice: nothing here is entered directly, it's computed by
// compileClassResults() in lib/term-result.ts from rows that already exist,
// then reviewed and published by an admin.
model TermResult {
  id String @id @default(uuid())

  studentId String
  // Restrict, not Cascade — same reasoning as every other student-record
  // relation in this schema: a compiled result is part of the permanent
  // record and must survive whatever happens to the User row upstream.
  student   Student @relation(fields: [studentId], references: [id], onDelete: Restrict)

  classId String
  class   Class  @relation(fields: [classId], references: [id], onDelete: Restrict)

  term    Term
  session String

  totalScore Int   // sum of Grade.total across the student's subjects, at compile time
  average    Float

  // Null until compiled, and — by the school's own decision — permanently
  // null for SS classes: subject streams (Science/Arts/Commercial) mean an
  // SS class's students don't all sit the same subjects, so a single class
  // rank isn't a meaningful comparison there. compileClassResults() simply
  // never sets these two for an SS class; JSS/Primary/Early Years get both.
  position  Int?
  classSize Int?   // denormalised at compile time, so an old rank stays meaningful
                    // even after later enrolment/withdrawal changes classSize

  // Filled by Phase 4 (attendance) — nullable until that ships, additive
  // when it does.
  attendancePresent Int?
  attendanceTotal   Int?

  classTeacherRemark String?
  principalRemark    String?

  status       ResultStatus @default(DRAFT)
  compiledAt   DateTime?
  compiledById String?
  publishedAt  DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([studentId, term, session])
  @@index([classId, term, session, status])
}

// Phase 4 — daily attendance. Whole-day-per-student, marked once by the
// class's form teacher (decision #5 in the plan, settled: "class teacher
// marks the student attendance" — the per-period alternative the plan
// sketched, one register per subject teacher per period, was explicitly not
// chosen).
//
// `date` is the calendar day being marked, `term`/`session` are denormalised
// from whatever the school's current-period Setting says AT THE MOMENT OF
// MARKING — same pattern Grade.classId and PsychomotorRating.classId already
// use for their denormalised fields, extended here to a term/session pair
// because Attendance has no other way to know which term a date belongs to
// (there is no school-calendar/term-date-range concept anywhere in this
// schema). This means attendance should be marked close to the day it
// covers, same expectation the rest of this app already carries for grades
// and psychomotor entry against the "current" period.
//
// @@unique on (studentId, date), not (studentId, term, session, date): a
// student cannot be marked twice for the same physical day, full stop,
// regardless of which term Setting happened to be active either time.
model Attendance {
  id String @id @default(uuid())

  studentId String
  // Restrict, not Cascade — same reasoning as every other student-record
  // relation in this schema: attendance is part of the permanent record and
  // must survive whatever happens to the User row upstream.
  student   Student @relation(fields: [studentId], references: [id], onDelete: Restrict)

  // Denormalised from Student, same reason Grade.classId is: lets the
  // admin's register/summary views filter without a join, and a mid-term
  // class change doesn't silently rewrite which class a past day's mark
  // "belongs" to.
  classId String
  class   Class  @relation(fields: [classId], references: [id], onDelete: Restrict)

  term    Term
  session String // "2026/2027"

  date DateTime @db.Date

  status AttendanceStatus

  // Restrict, not Cascade, same reasoning as Grade.teacher and
  // PsychomotorRating.ratedBy: removing a teacher must never delete a
  // child's records.
  markedById String
  markedBy   Teacher @relation(fields: [markedById], references: [id], onDelete: Restrict)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([studentId, date])
  @@index([classId, date])
  @@index([studentId, term, session])
}

// ─── Notifications ──────────────────────────────────────────────────────────

model Notification {
  id String @id @default(uuid())

  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  type  NotificationType
  title String
  body  String
  link  String? // in-app route the notification points at

  readAt DateTime?

  createdAt DateTime @default(now())

  // Partial-ish index for the unread badge count, which runs on every page.
  @@index([userId, readAt])
  @@index([userId, createdAt])
}

// ─── Infrastructure tables ──────────────────────────────────────────────────

// Race-safe sequence for admission and staff numbers.
//
// The obvious implementation — count() + 1 — is wrong: two admins enrolling at
// the same moment both read the same count and mint the same admission number,
// which is a number the school will write on paper records for years. Instead
// each key is incremented inside a transaction and the returned value is used.
//
// Keys look like "STU:2026:JSS3" and "TCH:2026".
model Counter {
  key   String @id
  value Int    @default(0)

  updatedAt DateTime @updatedAt
}

// Login attempt counters, shared across every serverless instance.
//
// This replaces an in-memory Map that documented its own uselessness: each
// instance had a private copy and a cold start wiped it, so the effective
// ceiling was (max x live instances) and it LOOSENED as the platform scaled
// up under load — precisely when an attack is happening.
//
// One row per bucket key ("id:SCIS/2026/JSS3/001" or "ip:41.58.x.x"). The
// window is fixed, not sliding: `resetAt` is stamped when a window opens and
// left alone until it lapses, so a blocked attacker cannot extend their own
// lockout indefinitely by continuing to hammer it — nor shorten it.
//
// The increment is a single INSERT ... ON CONFLICT statement (see
// lib/rate-limit.ts), for the same reason Counter is: read-then-write across
// two statements lets two concurrent attempts both read the same count and
// both be allowed.
model RateLimit {
  key     String   @id
  count   Int      @default(0)
  resetAt DateTime

  updatedAt DateTime @updatedAt

  // Expired rows are swept opportunistically; without this the sweep is a
  // sequential scan of every login anyone has ever attempted.
  @@index([resetAt])
}

// Singleton key/value rows: currentSession ("2026/2027"), currentTerm
// ("TERM_1"). Kept in the database so the school can roll into a new term
// from the admin UI without a code change and a redeploy.
model Setting {
  key   String @id
  value String

  updatedAt DateTime @updatedAt
}
